{
  "manifest_version": 3,
  "name": "Supplier Radar",
  "version": "0.1.0",
  "description": "Поиск поставщиков food-направления по открытым источникам — прямо из браузера.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Supplier Radar"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html",
  "permissions": ["storage"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"]
}
