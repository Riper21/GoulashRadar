# Supplier Radar environment — copy to .env and edit
# All values optional: the app runs without LLM (extraction cascade levels 1-3 only).

# --- LLM (level 4 of the extraction cascade; optional) ---
LLM_API_KEY=
# Any OpenAI-compatible endpoint, e.g. https://ai.dreamn-api-market.ru/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_S=60

# --- App ---
SR_PORT=8000
SR_DB_PATH=supplier_radar.db

# --- Pipeline budgets ---
SR_JOB_DEADLINE_S=120
SR_MAX_CANDIDATES=40
SR_MAX_PAGES_PER_JOB=25

# --- Cache TTLs (seconds) ---
SR_SERP_TTL_S=172800
SR_PAGE_TTL_S=604800

# --- Fetcher ---
SR_FETCH_TIMEOUT_S=12
SR_PER_DOMAIN_CONCURRENCY=1

# --- Engines ---
# yandex: captcha-prone for datacenter IPs, off by default
SR_YANDEX=0
# twogis: needs the official Catalog API key
SR_TWOGIS=0
